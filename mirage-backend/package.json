{
  "name": "mirage-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the Mirage store",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check",
    "db:query": "node scripts/query-products.js",
    "db:studio": "drizzle-kit studio",
    "db:seed:categories": "node scripts/seed-categories.js",
    "db:seed": "node scripts/seed-products.js",
    "db:count": "node scripts/count-products.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [],
  "author": "Mirage",
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "supertest": "^7.2.2"
  }
}
